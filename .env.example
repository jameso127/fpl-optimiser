# Where Parquet data lives. If DATA_BUCKET is set, gs://$DATA_BUCKET is used; otherwise DATA_DIR.
DATA_BUCKET=
DATA_DIR=./data

# Override the gameweek to ingest (default: next upcoming gameweek).
GAMEWEEK=

# FPL API etiquette.
FPL_BASE_URL=https://fantasy.premierleague.com/api
FPL_USER_AGENT=fpl-optimiser-demo/0.1
FPL_MIN_INTERVAL_SECONDS=0.5

# Model lifecycle: the train job registers versions under models/<MODEL_NAME>/.
MODEL_NAME=xpts-hurdle
HOLDOUT_GAMEWEEKS=8
# Stamped on model cards (set by the image build in CI; leave empty locally).
GIT_SHA=

LOG_LEVEL=INFO
